# Demo works without provider credentials. Never commit actual secrets.
AI_MODE=demo
DATA_DIR=./data
WORKSPACE_KEYS={"local-demo-key":"demo"}
# Set AI_MODE=gemini to enable the real model path. Re-upload documents after switching.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Optional external vector database (mandatory for production guard).
# QDRANT_URL=https://your-cluster.example
# QDRANT_API_KEY=
# Optional, set current model-specific prices. Zero means unknown, not free.
INPUT_USD_PER_MILLION=0
OUTPUT_USD_PER_MILLION=0
